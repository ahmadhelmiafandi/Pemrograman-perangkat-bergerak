# Contoh Konfigurasi Lingkungan REST API untuk Assignment 2
# Gunakan perintah berikut saat menjalankan aplikasi (flutter run):

# Mode Mock (Default - tanpa server eksternal):
# flutter run

# Mode Live (Server REST API Nyata):
# flutter run --dart-define=API_BASE_URL=https://your-server.example.com --dart-define=API_TOKEN=your_token_here

API_BASE_URL=https://your-server.example.com
API_TOKEN=your_token_here
